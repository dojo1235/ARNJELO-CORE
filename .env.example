# Server
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=arnjelo_core_db

# JWT
JWT_ACCESS_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_ACTION_SECRET=your_action_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACTION_EXPIRES_IN=10m

#PAYMENT
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhoook_secret

# R2 ACCOUNT
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# API KEYS (from Cloudflare R2)
R2_ACCESS_KEY=your_access_key_here
R2_SECRET_KEY=your_secret_key_here

# BUCKET
R2_BUCKET=your-bucket-name

# PUBLIC URL (VERY IMPORTANT)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# EMAIL (from Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Arnjelo <onboarding@resend.dev>"

# FRONTEND URL
CLIENT_URL=https://app.example.com